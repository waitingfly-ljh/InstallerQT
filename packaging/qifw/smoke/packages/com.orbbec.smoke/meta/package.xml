<?xml version="1.0" encoding="UTF-8"?>
<Package>
    <DisplayName>QIFW Smoke Payload</DisplayName>
    <Description>OrbbecSlicer QIFW smoke package: verifies the full binarycreator generate -> silent install -> verify -> silent uninstall loop.</Description>
    <Version>0.0.1</Version>
    <ReleaseDate>2026-10-30</ReleaseDate>
    <Name>com.orbbec.smoke</Name>

    <!-- Smoke package must be installed; users cannot uncheck it -->
    <Default>true</Default>
    <ForcedInstallation>true</ForcedInstallation>

    <!-- The directory structure under data/ is preserved as-is and installed to <TargetDir>/payload/...;
         run-smoke.ps1 compares hashes file by file -->
    <Script>installscript.qs</Script>
</Package>
